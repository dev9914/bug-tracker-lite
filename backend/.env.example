# HTTP port for the API server
PORT=5000

# Single origin allowed to call this API (CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas connection string (placeholder only - never commit real values)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bug-tracker-lite?retryWrites=true&w=majority

# Secret used to sign JWTs (placeholder only - generate your own, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret

# How long issued tokens stay valid (any `jsonwebtoken` duration string, e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# AWS region and the PRIVATE S3 bucket that stores bug images
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-private-bug-images-bucket

# Optional: only needed for local development. In AWS the SDK credential provider
# chain picks up an IAM role, so leave these unset outside local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
